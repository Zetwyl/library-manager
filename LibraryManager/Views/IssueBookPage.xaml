<Page x:Class="LibraryManager.Views.IssueBookPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LibraryManager.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="IssueBookPage">

    <Grid Background="White">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
            <TextBlock Text="ВЫДАЧА КНИГИ" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>

            <TextBlock Text="Книга:"/>
            <ComboBox x:Name="BookCmb" DisplayMemberPath="Title"/>

            <TextBlock Text="ФИО читателя:"/>
            <TextBox x:Name="ReaderNameTxb"/>

            <TextBlock Text="Дата выдачи:"/>
            <DatePicker x:Name="IssueDatePicker" Margin="0 0 0 20"/>

            <Button Content="Выдать" Click="Save_Click" Height="30" Margin="0 0 0 10"/>
            <Button Content="Отмена" Click="Cancel_Click" Height="30"/>
        </StackPanel>
    </Grid>
</Page>
